#!/bin/sh
#
# LISOC pre-commit gate.
#
# Runs the full test suite, a Prettier format check, and a production build.
# The commit is blocked unless all three pass.
#
# To bypass (e.g. a WIP or docs-only commit):  git commit --no-verify   (or -n)
#
# Activated via `core.hooksPath` — set automatically by the `prepare` npm
# script on `npm install`, or manually with:  git config core.hooksPath .githooks

set -e

echo "▶ pre-commit checks (bypass with: git commit --no-verify)"

echo "▶ [1/3] tests — npm test"
npm test

echo "▶ [2/3] format — npx prettier --check ."
npx prettier --check .

echo "▶ [3/3] build — npm run build"
npm run build

echo "✓ pre-commit checks passed"
